  "query": "\n        SELECT \n            b.user_id as id, \n            u.username as \"username!\",\n            b.expires_at, \n            b.created_at\n        FROM server_bans b\n        JOIN users u ON b.user_id = u.id\n        WHERE b.server_id = $1::uuid\n        ORDER BY b.created_at DESC\n        ",
